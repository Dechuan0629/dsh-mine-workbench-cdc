{
  "name": "dsh-mine-workbench",
  "version": "1.1.3",
  "private": false,
  "description": "DSH·Mine 私享工作台：macOS 液态玻璃品牌、驾驶舱首页、可拖动轮盘、专属设置与 Agent 预设。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dechuan0629/dsh-mine-workbench-cdc.git"
  },
  "homepage": "https://github.com/Dechuan0629/dsh-mine-workbench-cdc#readme",
  "bugs": {
    "url": "https://github.com/Dechuan0629/dsh-mine-workbench-cdc/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-bundle",
    "dsh-plugin",
    "workbench",
    "macos"
  ],
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
